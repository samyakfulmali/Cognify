# ===============================================================
# Cognify — AI Learning-Gap Detection Tutor Configuration
# ===============================================================

# LLM API Key Configuration
# Provide either GEMINI_API_KEY (recommended) or OPENAI_API_KEY.
# If both are absent or rate-limited, Cognify uses an intelligent pedagogical fallback.

# Google Gemini API Key (Get one from https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (or compatible provider such as Groq, OpenRouter, Ollama)
OPENAI_API_KEY=

# Generic LLM API key (if using a custom proxy/endpoint)
LLM_API_KEY=

# Optional model override (e.g. gemini-2.5-flash, gemini-1.5-flash, gpt-4o-mini)
# Default for Gemini: gemini-2.5-flash
# Default for OpenAI: gpt-4o-mini
LLM_MODEL=

# Optional base URL override (e.g. https://api.groq.com/openai/v1 or https://openrouter.ai/api/v1)
LLM_BASE_URL=
